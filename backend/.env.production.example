
NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/accesshub_prod

CLIENT_URL=https://your-frontend-domain.com

ACCESS_TOKEN_SECRET=replace_with_strong_64_byte_random_secret
REFRESH_TOKEN_SECRET=replace_with_different_strong_64_byte_random_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_strong_password
